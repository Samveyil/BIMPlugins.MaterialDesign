<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The scroll bars of BIMPluginsTheme, as Visual Studio draws them: a narrow track, small arrows at the ends that take
         the primary colour under the mouse, and a gray thumb that darkens under the mouse. The colours are the theme's
         BIMPlugins.ScrollBar.* brushes, light or dark. -->

    <!-- An arrow button: a small triangle, Tag holds its geometry. -->
    <Style x:Key="BIMPlugins.ScrollBarArrow" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Path x:Name="Arrow" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                              Fill="{DynamicResource BIMPlugins.ScrollBar.ArrowBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource BIMPlugins.PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Arrow" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The track on both sides of the thumb: a click there pages. -->
    <Style x:Key="BIMPlugins.ScrollBarPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BIMPlugins.ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Body" Background="{DynamicResource BIMPlugins.ScrollBar.ThumbBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource BIMPlugins.ScrollBar.ThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource BIMPlugins.ScrollBar.ThumbHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BIMPlugins.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource BIMPlugins.ScrollBar.TrackBrush}" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
        <Setter Property="Width" Value="14" />
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="14" />
                        </Grid.RowDefinitions>

                        <RepeatButton Style="{StaticResource BIMPlugins.ScrollBarArrow}" Command="ScrollBar.LineUpCommand" Tag="M 0 4 L 3.5 0 L 7 4 Z" />

                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource BIMPlugins.ScrollBarPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource BIMPlugins.ScrollBarThumb}" Margin="3 0" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource BIMPlugins.ScrollBarPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>

                        <RepeatButton Grid.Row="2" Style="{StaticResource BIMPlugins.ScrollBarArrow}" Command="ScrollBar.LineDownCommand" Tag="M 0 0 L 7 0 L 3.5 4 Z" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="14" />
                <Setter Property="MinHeight" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                </Grid.ColumnDefinitions>

                                <RepeatButton Style="{StaticResource BIMPlugins.ScrollBarArrow}" Command="ScrollBar.LineLeftCommand" Tag="M 4 0 L 0 3.5 L 4 7 Z" />

                                <Track x:Name="PART_Track" Grid.Column="1">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource BIMPlugins.ScrollBarPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource BIMPlugins.ScrollBarThumb}" Margin="0 3" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource BIMPlugins.ScrollBarPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>

                                <RepeatButton Grid.Column="2" Style="{StaticResource BIMPlugins.ScrollBarArrow}" Command="ScrollBar.LineRightCommand" Tag="M 0 0 L 4 3.5 L 0 7 Z" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Every scroll bar of a window with the theme, instead of MaterialDesign's own. -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource BIMPlugins.ScrollBar}" />
</ResourceDictionary>
