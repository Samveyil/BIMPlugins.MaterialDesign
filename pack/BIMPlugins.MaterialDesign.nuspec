<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>BIMPlugins.MaterialDesign</id>
    <version>$version$</version>
    <title>BIMPlugins.MaterialDesign</title>
    <authors>Samir Shibliev, MaterialDesignInXAML contributors</authors>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/Samveyil/BIMPlugins.MaterialDesign</projectUrl>
    <readme>README.md</readme>
    <icon>icon.png</icon>
    <description>Material Design in XAML Toolkit $materialDesignVersion under assembly names of its own (BIMPlugins.MaterialDesign, BIMPlugins.MaterialDesign.Colors), for Revit add-ins: it never shares styles with another add-in's MaterialDesign in the one Revit process. Namespaces and XAML are MaterialDesign's. Adds BIMPluginsTheme, the BIMPlugins colours in light and dark.</description>
    <tags>WPF XAML MaterialDesign Revit BIMPlugins</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="Microsoft.Xaml.Behaviors.Wpf" version="1.1.77" />
      </group>
      <group targetFramework="net8.0-windows7.0">
        <dependency id="Microsoft.Xaml.Behaviors.Wpf" version="1.1.77" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net8.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>
    </frameworkReferences>
  </metadata>
  <files>
    <file src="$output$\net462\BIMPlugins.MaterialDesign.dll" target="lib\net462" />
    <file src="$output$\net462\BIMPlugins.MaterialDesign.xml" target="lib\net462" />
    <file src="$output$\net462\BIMPlugins.MaterialDesign.Colors.dll" target="lib\net462" />
    <file src="$output$\net8.0-windows\BIMPlugins.MaterialDesign.dll" target="lib\net8.0-windows7.0" />
    <file src="$output$\net8.0-windows\BIMPlugins.MaterialDesign.xml" target="lib\net8.0-windows7.0" />
    <file src="$output$\net8.0-windows\BIMPlugins.MaterialDesign.Colors.dll" target="lib\net8.0-windows7.0" />
    <file src="..\README.md" target="" />
    <file src="icon.png" target="" />
    <file src="..\LICENSE.txt" target="" />
  </files>
</package>
